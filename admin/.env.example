# Admin — local env
# Copy to admin/.env and restart Vite (`pnpm dev:admin`).

# Google Maps JavaScript API key (Places — address autocomplete on offline orders).
# Same key as client is fine. Enable: Maps JavaScript API + Places API (New).
# HTTP referrers should include admin local + prod, e.g.:
#   http://localhost:5175/*
#   https://your-admin-domain/*
VITE_GOOGLE_MAPS_API_KEY=
