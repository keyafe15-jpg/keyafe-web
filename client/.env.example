# Storefront (client) — local env
# Copy to client/.env and restart Vite (`pnpm dev:client`).

# Google Maps JavaScript API key (Places API New — Place Autocomplete + reviews).
# Enable APIs: Maps JavaScript API + Places API (New).
# Application restriction: HTTP referrers (websites) — NOT IP addresses.
#   http://localhost:5173/*
#   https://your-production-domain/*
# IP restrictions only work for server-side keys; browser Places calls will 403.
VITE_GOOGLE_MAPS_API_KEY=

# Google Business Profile Place ID (for homepage reviews).
# Find it: Google Maps → your listing → Share → copy place link, or use
# https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
# Without this, the Google reviews section is hidden.
VITE_GOOGLE_PLACE_ID=
