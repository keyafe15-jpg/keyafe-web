// Walk-in counter sales at stalls we run on site (e.g. a live kitchen in a
// corporate office). Anonymous and paid on the spot, so they live apart from
// Order, but they feed the dashboard's sales/received totals.

enum StallDayStatus {
  OPEN
  CLOSED
}

enum StallSaleKind {
  ITEMIZED // Staff tapped menu items; the whole total is cash, UPI or due
  CONSOLIDATED // Lump cash/UPI/due figure entered when there was no time to itemise
}

enum StallKind {
  OFFICE // Long-running counter, e.g. a corporate office; no stall charge
  EXHIBITION // Temporary stall between startDate and endDate
}

enum StallChargeBasis {
  TOTAL // chargeAmount covers the whole exhibition
  PER_DAY // chargeAmount × number of days (endDate - startDate + 1)
}

model Stall {
  id            String           @id @default(cuid())
  name          String
  kind          StallKind        @default(OFFICE)
  // Venue and address, free text.
  location      String?
  // IST calendar days; set for exhibitions only.
  startDate     DateTime?        @db.Date
  endDate       DateTime?        @db.Date
  chargeAmount  Decimal          @default(0) @db.Decimal(10, 2)
  chargeBasis   StallChargeBasis @default(TOTAL)
  isActive      Boolean          @default(true)
  sortOrder     Int              @default(0)
  // Company billed at month end for office breakfast; printed on its invoice.
  billToName    String?
  billToPhone   String?
  billToEmail   String?
  billToGstin   String?
  // { line1, line2?, city?, pincode? }, same keys as an order billing address.
  billToAddress Json?
  menuItems     StallMenuItem[]
  days          StallDay[]
  breakfasts    StallBreakfast[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// Breakfast plates served at an office stall, billed to the company monthly.
// Kept out of stall sales: the money is counted once, as the bill's order.
model StallBreakfast {
  id            String   @id @default(cuid())
  stallId       String
  stall         Stall    @relation(fields: [stallId], references: [id], onDelete: Restrict)
  // IST calendar day the plates were served.
  date          DateTime @db.Date
  plates        Int
  // The round figure charged per plate, not the sum of what was on it.
  platePrice    Decimal  @db.Decimal(10, 2)
  // What was on the plate, e.g. "Poha, boiled egg, toast, tea".
  items         String
  note          String?
  // The month-end bill this entry went on. Billed entries are locked.
  orderId       String?
  order         Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdByName String?
  createdAt     DateTime @default(now())

  @@index([stallId, date])
  @@index([orderId])
}

model StallMenuItem {
  id        String   @id @default(cuid())
  stallId   String
  stall     Stall    @relation(fields: [stallId], references: [id], onDelete: Cascade)
  name      String
  price     Decimal  @db.Decimal(10, 2)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stallId, sortOrder])
}

model StallDay {
  id           String         @id @default(cuid())
  stallId      String
  // Restrict so deleting a stall can't wipe its sales history; deactivate it instead.
  stall        Stall          @relation(fields: [stallId], references: [id], onDelete: Restrict)
  // IST calendar day the sales belong to.
  date         DateTime       @db.Date
  status       StallDayStatus @default(OPEN)
  closedAt     DateTime?
  closedById   String?
  closedByName String?
  sales        StallSale[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([stallId, date])
  @@index([date])
}

model StallSale {
  id            String          @id @default(cuid())
  dayId         String
  day           StallDay        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  kind          StallSaleKind
  cashAmount    Decimal         @default(0) @db.Decimal(10, 2)
  upiAmount     Decimal         @default(0) @db.Decimal(10, 2)
  // Sold on credit and not yet paid. Counts as sales, not as money received.
  dueAmount     Decimal         @default(0) @db.Decimal(10, 2)
  // Who owes the due, free text (name, desk, company).
  dueFrom       String?
  // Set when the due is collected; the amount then moves into cashAmount / upiAmount.
  duePaidAt     DateTime?
  duePaidByName String?
  note          String?
  createdById   String?
  createdByName String?
  items         StallSaleItem[]
  createdAt     DateTime        @default(now())

  @@index([dayId, createdAt])
}

model StallSaleItem {
  id         String    @id @default(cuid())
  saleId     String
  sale       StallSale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Null once the menu item is deleted; name/price below are snapshots.
  menuItemId String?
  name       String
  price      Decimal   @db.Decimal(10, 2)
  qty        Int

  @@index([saleId])
}
