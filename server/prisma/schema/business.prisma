enum GstScheme {
  REGULAR
  COMPOSITE
}

model BusinessSettings {
  id                     String    @id @default(cuid())
  legalName              String
  tradeName              String
  gstin                  String?
  gstScheme              GstScheme @default(REGULAR)
  registeredAddress      Json // { line1, line2, city, state, stateCode, pincode }
  invoicePrefix          String    @default("KEY")
  fyStartMonth           Int       @default(4) // April = Indian FY start
  // Printed in the terms box on delivery challans; the box is omitted when blank.
  challanTerms           String?
  supportEmail           String
  supportPhone           String
  // Second number shown on the storefront alongside supportPhone.
  altPhone               String?
  // Where the new-order notification email is sent. Falls back to supportEmail if null.
  orderNotificationEmail String?
  currency               String    @default("INR")

  // Storefront profile. The shop name comes from tradeName / legalName above.
  tagline         String?
  logoUrl         String? // null → the bundled /logo.png
  socialLinks     Json? // { instagram, facebook, zomato, swiggy }
  platformRatings Json? // { zomato: { rating, count }, swiggy: { rating, count } }
  // Public listing for search engines; kept in step with the Google Business Profile.
  publicLocation  Json? // { street, locality, city, region, postalCode, areaServed[], openingHours }

  // Manual UPI collection (offline/order-link flows) — no gateway, no fees.
  // Customers pay this VPA directly and upload a screenshot as proof.
  upiId        String?
  upiPayeeName String?

  // Delivery — global rules
  timezone            String  @default("Asia/Kolkata")
  sameDayCutoff       String  @default("17:30") // "HH:mm" in `timezone` (regular / book-ahead track)
  defaultDeliveryFee  Decimal @default(0) @db.Decimal(10, 2)
  minSameDayLeadHours Int     @default(0) // added to cutoff check for safety (e.g., 2h prep)

  // Same-Day / "Express" storefront window & surcharge.
  expressStart        String  @default("11:00") // storefront opens
  expressEnd          String  @default("23:00") // storefront closes
  expressSurchargeFee Decimal @default(50) @db.Decimal(10, 2) // added on top of pincode fee for express orders

  // Same-Day store manual controls.
  isSameDayStoreClosed Boolean @default(false) // admin kill-switch; overrides any schedule
  sameDayClosedMessage String  @default("Sorry — we're closed right now. Please check back later.")

  // Slim storefront ticker. Hidden when announcementEnabled is false or text is empty.
  announcementEnabled   Boolean @default(false)
  announcementText      String  @default("")
  announcementLinkUrl   String?
  announcementLinkLabel String?

  // Storefront-only free local delivery window. Null until = off.
  freeDeliveryFrom    DateTime?
  freeDeliveryUntil   DateTime?
  freeDeliveryMinCart Decimal?  @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One row per financial-year document series, e.g. "KEY/26-27" for tax
// invoices and "KEY/DC/26-27" for delivery challans. GST requires these numbers
// to be sequential with no gaps and never reused, so `lastNumber` is
// incremented atomically inside a transaction rather than derived from a count
// of existing orders.
model InvoiceCounter {
  series     String   @id
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
}
