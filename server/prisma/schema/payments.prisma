enum PaymentAttemptStatus {
  CREATED // Gateway order created, customer hasn't finished paying
  SUCCESS
  FAILED
  USER_DROPPED // Customer closed/abandoned the gateway page
  EXPIRED // Gateway order expired or was terminated before payment
}

// One row per gateway order. A retry after a failed/expired attempt opens a
// new row, so this doubles as the audit trail for every online payment.
model PaymentAttempt {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider String @default("cashfree")

  // Our order id as sent to the gateway (orderNumber, then orderNumber-2, …).
  gatewayOrderId   String  @unique
  paymentSessionId String?
  amount           Decimal @db.Decimal(10, 2)

  status           PaymentAttemptStatus @default(CREATED)
  gatewayPaymentId String?
  // upi / card / net_banking / wallet …
  paymentGroup     String?
  // Last payload seen from the gateway (verify call or webhook).
  raw              Json?

  refunds GatewayRefund[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

enum GatewayRefundStatus {
  PENDING // Accepted by the gateway, money not yet back with the customer
  SUCCESS
  CANCELLED // Gateway gave up; the money was not returned
  ONHOLD
}

// Money sent back through the gateway against a successful online payment.
model GatewayRefund {
  id               String         @id @default(cuid())
  orderId          String
  order            Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentAttemptId String
  paymentAttempt   PaymentAttempt @relation(fields: [paymentAttemptId], references: [id], onDelete: Cascade)
  // Set when the refund was given as a credit note after billing; null when
  // it came from editing items before the bill.
  creditNoteId     String?        @unique
  creditNote       CreditNote?    @relation(fields: [creditNoteId], references: [id], onDelete: SetNull)
  provider         String         @default("cashfree")

  gatewayOrderId  String
  // Our id as sent to the gateway; also the idempotency key.
  refundId        String              @unique
  gatewayRefundId String?
  amount          Decimal             @db.Decimal(10, 2)
  status          GatewayRefundStatus @default(PENDING)
  note            String?
  createdByName   String?
  raw             Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}
