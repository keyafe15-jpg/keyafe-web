// Custom-quote requests submitted from /get-quote.
// Guests submit these; admin/staff triage & respond via the admin panel.

enum QuoteStatus {
  NEW
  CONTACTED
  QUOTED
  CONVERTED
  CLOSED
}

model QuoteRequest {
  id           String   @id @default(cuid())
  name         String
  phone        String
  email        String?
  address      String
  deliveryDate DateTime
  description  String // what the customer wants

  referenceImages String[] // Cloudinary URLs; API enforces max = 4
  notes           String? // customer's extra notes (allergies, delivery instructions)

  // Corporate / party intake. All nullable: an ordinary custom-cake enquiry
  // fills none of these. companyName + gstin mirror the fields captured at
  // checkout, so a converted quote already has what the GST invoice needs.
  companyName String?
  gstin       String?
  headcount   Int? // rough number of people to serve
  eventType   String? // e.g. corporate-gifting, office-party, birthday

  status       QuoteStatus @default(NEW)
  adminNotes   String? // internal note added while triaging
  quotedAmount Decimal?    @db.Decimal(10, 2) // filled when admin responds with a price
  quotedAt     DateTime?
  respondedAt  DateTime?

  assignedToId String?
  assignedTo   User?   @relation("QuoteAssignee", fields: [assignedToId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}
