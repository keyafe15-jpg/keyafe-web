enum OrderStatus {
  PENDING // Just created, awaiting payment/confirmation
  CONFIRMED
  IN_KITCHEN
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PARTIAL // Advance received, remainder still pending
  PAID
  FAILED
  REFUNDED
}

enum OrderFulfillment {
  DELIVERY
  PICKUP
}

enum PaymentMode {
  FULL // Customer/admin collected the entire total upfront
  ADVANCE // Only part of the total was collected; rest stays pending
}

enum OrderSource {
  STOREFRONT // Customer self-serve on the storefront
  OFFLINE_LINK // Admin generated a link, customer redeemed it (/o/:token)
  OFFLINE_DIRECT // Admin filled everything in the offline order form
}

model Order {
  id          String @id @default(cuid())
  // Human-friendly reference: KEY-YYMMDD-XXXXXX. Shared with customer.
  orderNumber String @unique

  // Nullable link to registered user; guests keep this null and rely on the
  // snapshot fields below.
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  // Customer snapshot at time of order (guest checkout friendly)
  customerName  String
  customerPhone String
  customerEmail String?

  // Fulfillment
  fulfillment       OrderFulfillment
  // Snapshotted delivery address; null for pickup. Shape: { line1, line2?, landmark?, pincode, city, area?, state, stateCode }
  deliveryAddress   Json?
  // Individual delivery dates/slots live on OrderItem (per-line).

  // Pricing snapshots
  subtotal    Decimal @db.Decimal(10, 2)
  deliveryFee Decimal @default(0) @db.Decimal(10, 2)
  discount    Decimal @default(0) @db.Decimal(10, 2)
  couponCode  String?
  total       Decimal @db.Decimal(10, 2)

  // GST breakup snapshots. taxableAmount = subtotal minus GST when the item
  // prices are inclusive; equal to subtotal when exclusive. Same-state ships
  // to CGST + SGST; different-state ships to IGST.
  taxableAmount Decimal @default(0) @db.Decimal(10, 2)
  cgstAmount    Decimal @default(0) @db.Decimal(10, 2)
  sgstAmount    Decimal @default(0) @db.Decimal(10, 2)
  igstAmount    Decimal @default(0) @db.Decimal(10, 2)

  // Payment (simple stub until Razorpay lands)
  paymentMethod String        @default("cod") // "cod" | "upi" | "razorpay"
  paymentStatus PaymentStatus @default(PENDING)
  paymentMode   PaymentMode   @default(FULL)
  // Amount collected upfront for offline orders; total - advanceAmount is still owed.
  advanceAmount Decimal       @default(0) @db.Decimal(10, 2)
  // Customer/admin-uploaded proof of the UPI/bank transfer.
  paymentScreenshotUrl String?

  // Status
  status OrderStatus @default(PENDING)

  // Where the order came from — used in admin filtering and reporting.
  source OrderSource @default(STOREFRONT)

  customerNotes String?
  adminNotes    String?

  items OrderItem[]
  couponRedemption CouponRedemption?
  // Set (1:1) when this order was placed via a pre-filled OrderLink.
  sourceLink OrderLink?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([customerPhone])
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // Snapshot everything so the order row is self-contained even if the
  // product is later edited or deleted. `productId` is nullable to support
  // free-form / custom-cake items placed via an OrderLink.
  productId    String?
  productName  String
  productSlug  String?
  productImage String?

  sizeGrams     Int?
  sizeLabel     String?
  flavourId     String?
  flavourName   String?
  messageOnCake String?
  instructions  String?
  // For custom cake orders (from an OrderLink) — customer's reference photo.
  referenceImageUrl String?

  // Per-line delivery/pickup slot. Null for pan-India courier-shipped items,
  // which skip local date/slot selection entirely.
  deliveryDate      DateTime?
  deliverySlotKey   String?
  deliverySlotLabel String?

  unitPrice Decimal @db.Decimal(10, 2)
  qty       Int
  lineTotal Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
}
