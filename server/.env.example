# Server
NODE_ENV=development
PORT=4000

# CORS
CLIENT_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5175

# Postgres (defaults match docker-compose.yml at repo root)
DATABASE_URL=postgresql://keyafe:keyafeDevPass@127.0.0.1:5432/keyafe?schema=public

# Logging
LOG_LEVEL=info

# Storage — swappable provider. LOCAL uses disk under UPLOAD_DIR.
# Switch to "r2" / "s3" / "cloudinary" later without touching app code.
STORAGE_PROVIDER=local
UPLOAD_DIR=./uploads
PUBLIC_BASE_URL=http://localhost:4000
UPLOAD_TOKEN_SECRET=change-me-in-prod-at-least-32-chars-long
UPLOAD_MAX_BYTES=12582912

# Web Push (VAPID) — generate with:
#   node -e "console.log(JSON.stringify(require('web-push').generateVAPIDKeys()))"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@keyafe.in

# WhatsApp Cloud API — leave blank until Meta is connected.
# Staff cancel/new-order alerts go to WHATSAPP_STAFF_TO (comma-separated).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_STAFF_TO=
